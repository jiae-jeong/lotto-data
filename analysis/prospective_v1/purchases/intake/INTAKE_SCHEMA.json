{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "E044 actual purchase intake",
  "type": "object",
  "required": ["target_round", "purchase", "generated_at", "submitted_at", "training_through_round", "lines"],
  "properties": {
    "target_round": {"type": "integer", "minimum": 1},
    "purchase": {"const": true},
    "generated_at": {"type": "string", "format": "date-time"},
    "submitted_at": {"type": "string", "format": "date-time"},
    "training_through_round": {"type": "integer", "minimum": 0},
    "rationale": {"type": "string", "minLength": 1},
    "source_reference": {"type": "string", "minLength": 1},
    "lines": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["numbers", "source_model", "model_version"],
        "properties": {
          "numbers": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 45}},
          "source_model": {"type": "string", "minLength": 1},
          "model_version": {"type": "string", "minLength": 1},
          "training_through_round": {"type": "integer", "minimum": 0},
          "generated_at": {"type": "string", "format": "date-time"},
          "submitted_at": {"type": "string", "format": "date-time"},
          "rationale": {"type": "string", "minLength": 1},
          "source_reference": {"type": "string", "minLength": 1}
        },
        "anyOf": [{"required": ["rationale"]}, {"required": ["source_reference"]}]
      }
    }
  },
  "anyOf": [{"required": ["rationale"]}, {"required": ["source_reference"]}]
}

